# HR Platform On-Premises MVP Production Configuration
# Copy this file to .env and ensure secrets are securely populated

# Database Configuration (PostgreSQL 16 Alpine)
# DB_PASSWORD: Cryptographically secure random password for internal PostgreSQL
DB_PASSWORD=replace_with_strong_random_db_password_min24chars

# Cryptographic Keys (Mandatory - min 32 chars / 64 hex chars)
# SYSTEM_ENCRYPTION_KEY: 32-byte hex key for AES-256-GCM identity encryption at rest
SYSTEM_ENCRYPTION_KEY=replace_with_64_hex_chars_or_32_byte_random_string_here
# APP_SECRET: Minimum 32-character secret for session token signing and blind indexing
APP_SECRET=replace_with_cryptographic_app_secret_minimum_32_characters_long

# Network & Host Binding
# HOST_BIND_IP: 127.0.0.1 for protected loopback-only mode (default). Set to 0.0.0.0 for LAN mode.
HOST_BIND_IP=127.0.0.1
# CADDYFILE_PATH: Caddy configuration file (Caddyfile.loopback for 127.0.0.1 or Caddyfile.lan for internal TLS)
CADDYFILE_PATH=./docker/caddy/Caddyfile.loopback
# APP_URL: Public URL where operators reach the web UI (e.g. http://localhost or https://hr-platform.lan)
APP_URL=http://localhost

# Web-to-API Network Contract
# API_INTERNAL_URL: Internal Docker mesh URL used by Next.js server runtime / standalone rewrites
API_INTERNAL_URL=http://api:3001
# API_URL: Public or external fallback API URL for development workstations
API_URL=http://localhost:3001

# Storage Paths (Mounted inside containers as persistent Docker volumes)
STORAGE_LOCAL_PATH=/app/storage/uploads
BACKUP_LOCAL_PATH=/app/storage/backups
