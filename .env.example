# ==============================================================================
# Environment Configuration Template (Placeholders only - DO NOT commit real secrets)
# ==============================================================================

# Node Environment: development | test | production
NODE_ENV=development

# Application Ports
PORT_WEB=3000
PORT_API=3001

# Public URLs
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# Database Connection (PostgreSQL 16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hr_platform_dev?schema=public"

# Session & Security Secret (min 32 characters in production)
APP_SECRET=development_secret_do_not_use_in_production_min32chars

# File Storage Configuration: local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads

# System Defaults
DEFAULT_LOCALE=en
DEFAULT_CARD_WIDTH_MM=60
DEFAULT_CARD_HEIGHT_MM=90
