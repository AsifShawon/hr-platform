generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PermissionType {
  PEOPLE_VIEW         @map("people.view")
  PEOPLE_EDIT         @map("people.edit")
  IDENTITY_REVEAL     @map("identity.reveal")
  IDENTITY_EDIT       @map("identity.edit")
  CARDS_DESIGN        @map("cards.design")
  CARDS_PRINT         @map("cards.print")
  CARDS_ISSUE         @map("cards.issue")
  CARDS_REVOKE        @map("cards.revoke")
  EXPORTS_CREATE      @map("exports.create")
  ORGANIZATION_MANAGE @map("organization.manage")
  USERS_MANAGE        @map("users.manage")
  ROLES_MANAGE        @map("roles.manage")
  AUDIT_VIEW          @map("audit.view")
  BACKUP_MANAGE       @map("backup.manage")
  SYSTEM_MANAGE       @map("system.manage")
}

model SystemInstallation {
  id             String    @id @default(uuid())
  isActivated    Boolean   @default(false) @map("is_activated")
  activatedAt    DateTime? @map("activated_at")
  deploymentMode String    @default("local") @map("deployment_mode")
  lanEnabled     Boolean   @default(false) @map("lan_enabled")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@map("system_installations")
}

model Tenant {
  id                     String                  @id @default(uuid())
  slug                   String                  @unique
  name                   String
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  organizations          Organization[]
  locations              Location[]
  orgUnits               OrgUnit[]
  people                 Person[]
  employments            Employment[]
  identityDocuments      IdentityDocument[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues      CustomFieldValue[]
  users                  User[]
  roles                  Role[]
  auditEvents            AuditEvent[]
  jobQueues              JobQueue[]
  provisioningTokens     ProvisioningToken[]
  mediaAssets            MediaAsset[]
  phoneHandoffTokens     PhoneHandoffToken[]
  cardFormats            CardFormat[]
  cardTemplates          CardTemplate[]
  templateVersions       TemplateVersion[]
  templateAssignments    TemplateAssignment[]
  importJobs             ImportJob[]
  exportJobs             ExportJob[]
  backupJobs             BackupJob[]
  backupSchedules        BackupSchedule[]
  cardIssues             CardIssue[]
  printJobs              PrintJob[]
  printJobItems          PrintJobItem[]

  @@map("tenants")
}

enum LocationType {
  HEADQUARTERS
  OFFICE
  FACTORY
  BRANCH
  SITE
  WAREHOUSE
  OTHER
}

enum OrgUnitType {
  DIVISION
  DEPARTMENT
  SECTION
  TEAM
  LINE
  OTHER
}

model Organization {
  id                 String       @id @default(uuid())
  tenantId           String       @map("tenant_id")
  name               String
  displayName        String?      @map("display_name")
  code               String
  logoPath           String?      @map("logo_path")
  primaryColor       String       @default("#134E4A") @map("primary_color")
  secondaryColor     String       @default("#0F766E") @map("secondary_color")
  accentColor        String       @default("#14B8A6") @map("accent_color")
  locale             String       @default("en-US")
  timezone           String       @default("Asia/Dhaka")
  address            Json?
  contactEmail       String?      @map("contact_email")
  contactPhone       String?      @map("contact_phone")
  employeeNumberRule Json?        @map("employee_number_rule")
  isDefault          Boolean      @default(true) @map("is_default")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  tenant             Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  locations          Location[]
  orgUnits           OrgUnit[]
  employments        Employment[]
  roleGrants         RoleGrant[]
  cardTemplates      CardTemplate[]
  importJobs         ImportJob[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("organizations")
}

model Location {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  organizationId String       @map("organization_id")
  name           String
  code           String
  type           LocationType @default(OFFICE)
  address        Json?
  contactPhone   String?      @map("contact_phone")
  isDefault      Boolean      @default(false) @map("is_default")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orgUnits       OrgUnit[]
  employments    Employment[]
  roleGrants     RoleGrant[]

  @@unique([organizationId, code])
  @@index([tenantId])
  @@index([organizationId])
  @@map("locations")
}

model OrgUnit {
  id             String       @id @default(uuid())
  tenantId       String       @map("tenant_id")
  organizationId String       @map("organization_id")
  parentId       String?      @map("parent_id")
  name           String
  nameBangla     String?      @map("name_bangla")
  code           String
  type           OrgUnitType  @default(DEPARTMENT)
  locationId     String?      @map("location_id")
  isArchived     Boolean      @default(false) @map("is_archived")
  sortOrder      Int          @default(0) @map("sort_order")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         OrgUnit?     @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children       OrgUnit[]    @relation("OrgUnitHierarchy")
  location       Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  employments    Employment[]

  @@unique([organizationId, parentId, name])
  @@unique([organizationId, code])
  @@index([tenantId])
  @@index([organizationId])
  @@index([parentId])
  @@map("org_units")
}

// ==============================================================================
// Phase 4: Person, Employment, Identity Document & Custom Fields
// ==============================================================================

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum EmploymentStatus {
  PREBOARDING
  ACTIVE
  ON_LEAVE
  INACTIVE
  SEPARATED
}

enum JobCategory {
  EXECUTIVE
  MANAGEMENT
  STAFF
  OPERATOR
  WORKER
  CONTRACTOR
  INTERN
  OTHER
}

enum IdentityDocumentType {
  NID
  SMART_NID
  BIRTH_CERTIFICATE
  PASSPORT
  DRIVING_LICENSE
  OTHER
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  BOOLEAN
}

model Person {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  displayName       String             @map("display_name")
  displayNameLatin  String?            @map("display_name_latin")
  displayNameNative String?            @map("display_name_native")
  givenName         String?            @map("given_name")
  familyName        String?            @map("family_name")
  middleName        String?            @map("middle_name")
  phoneticName      String?            @map("phonetic_name")
  dateOfBirth       DateTime?          @map("date_of_birth") @db.Date
  gender            Gender             @default(UNDISCLOSED)
  bloodGroup        String?            @map("blood_group")
  primaryPhone      String?            @map("primary_phone")
  primaryEmail      String?            @map("primary_email")
  address           Json?
  photoMediaId      String?            @map("photo_media_id")
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employments       Employment[]
  identityDocuments IdentityDocument[]
  customFieldValues CustomFieldValue[]
  mediaAssets       MediaAsset[]       @relation("PersonMediaAssets")
  photoMedia        MediaAsset?        @relation("PersonPhoto", fields: [photoMediaId], references: [id], onDelete: SetNull)
  cardIssues        CardIssue[]

  @@index([tenantId, displayName])
  @@index([tenantId, displayNameNative])
  @@index([tenantId, primaryPhone])
  @@index([tenantId, primaryEmail])
  @@map("people")
}

model Employment {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  personId          String             @map("person_id")
  organizationId    String             @map("organization_id")
  locationId        String?            @map("location_id")
  orgUnitId         String?            @map("org_unit_id")
  employeeNumber    String             @map("employee_number")
  jobTitle          String             @map("job_title")
  jobCategory       JobCategory        @default(STAFF) @map("job_category")
  joinDate          DateTime           @map("join_date") @db.Date
  endDate           DateTime?          @map("end_date") @db.Date
  status            EmploymentStatus   @default(ACTIVE)
  isPrimary         Boolean            @default(true) @map("is_primary")
  version           Int                @default(1)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person            Person             @relation(fields: [personId], references: [id], onDelete: Cascade)
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location          Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  orgUnit           OrgUnit?           @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)
  customFieldValues CustomFieldValue[]
  cardIssues        CardIssue[]

  @@unique([tenantId, organizationId, employeeNumber])
  @@index([tenantId, organizationId, status])
  @@index([tenantId, locationId])
  @@index([tenantId, orgUnitId])
  @@index([tenantId, joinDate])
  @@index([tenantId, employeeNumber])
  @@map("employments")
}

model IdentityDocument {
  id                      String               @id @default(uuid())
  tenantId                String               @map("tenant_id")
  personId                String               @map("person_id")
  documentType            IdentityDocumentType @map("document_type")
  country                 String               @default("BGD")
  documentNumberEncrypted String               @map("document_number_encrypted")
  documentNumberMasked    String               @map("document_number_masked")
  documentNumberHash      String               @map("document_number_hash")
  issueDate               DateTime?            @map("issue_date") @db.Date
  expiryDate              DateTime?            @map("expiry_date") @db.Date
  isVerified              Boolean              @default(false) @map("is_verified")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")

  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person                  Person               @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentNumberHash])
  @@index([tenantId, personId])
  @@map("identity_documents")
}

model CustomFieldDefinition {
  id              String             @id @default(uuid())
  tenantId        String             @map("tenant_id")
  organizationId  String?            @map("organization_id")
  name            String
  key             String
  fieldType       CustomFieldType    @map("field_type")
  options         Json?
  isRequired      Boolean            @default(false) @map("is_required")
  validationRegex String?            @map("validation_regex")
  sortOrder       Int                @default(0) @map("sort_order")
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  values          CustomFieldValue[]

  @@unique([tenantId, key])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id                String                @id @default(uuid())
  tenantId          String                @map("tenant_id")
  fieldDefinitionId String                @map("field_definition_id")
  personId          String?               @map("person_id")
  employmentId      String?               @map("employment_id")
  valueText         String?               @map("value_text")
  valueNumber       Float?                @map("value_number")
  valueDate         DateTime?             @map("value_date") @db.Date
  valueBoolean      Boolean?              @map("value_boolean")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition        CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)
  person            Person?               @relation(fields: [personId], references: [id], onDelete: Cascade)
  employment        Employment?           @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@index([tenantId, personId])
  @@index([tenantId, employmentId])
  @@map("custom_field_values")
}

model User {
  id                   String              @id @default(uuid())
  tenantId             String              @map("tenant_id")
  username             String
  email                String?
  passwordHash         String              @map("password_hash")
  isTemporaryBootstrap Boolean             @default(false) @map("is_temporary_bootstrap")
  mustChangePassword   Boolean             @default(false) @map("must_change_password")
  isActive             Boolean             @default(true) @map("is_active")
  failedLoginAttempts  Int                 @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?           @map("locked_until")
  lastLoginAt          DateTime?           @map("last_login_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleGrants           RoleGrant[]
  sessions             Session[]
  recoveryCodes        RecoveryCode[]
  provisioningTokens   ProvisioningToken[]
  importJobs           ImportJob[]
  exportJobs           ExportJob[]
  backupJobs           BackupJob[]
  cardIssuesIssued     CardIssue[]         @relation("CardIssuedByUser")
  cardIssuesRevoked    CardIssue[]         @relation("CardRevokedByUser")
  printJobsCreated     PrintJob[]          @relation("PrintJobCreatedByUser")
  printJobsConfirmed   PrintJob[]          @relation("PrintJobConfirmedByUser")

  @@unique([tenantId, username])
  @@index([tenantId])
  @@map("users")
}

model RecoveryCode {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("recovery_codes")
}

enum ProvisioningTokenType {
  FIRST_OWNER_ACTIVATION
  PASSWORD_RESET
}

model ProvisioningToken {
  id        String                @id @default(uuid())
  tenantId  String                @map("tenant_id")
  userId    String                @map("user_id")
  tokenHash String                @unique @map("token_hash")
  type      ProvisioningTokenType
  expiresAt DateTime              @map("expires_at")
  usedAt    DateTime?             @map("used_at")
  createdAt DateTime              @default(now()) @map("created_at")

  tenant    Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([userId])
  @@map("provisioning_tokens")
}

model Role {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  name        String
  description String?
  isBuiltIn   Boolean          @default(false) @map("is_built_in")
  permissions PermissionType[]
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  roleGrants  RoleGrant[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model RoleGrant {
  id             String        @id @default(uuid())
  userId         String        @map("user_id")
  roleId         String        @map("role_id")
  organizationId String?       @map("organization_id")
  locationId     String?       @map("location_id")
  createdAt      DateTime      @default(now()) @map("created_at")

  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role          @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location       Location?     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([roleId])
  @@index([organizationId])
  @@index([locationId])
  @@map("role_grants")
}

model Session {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  tokenHash    String   @unique @map("token_hash")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  details    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("audit_events")
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model JobQueue {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  type        String
  payload     Json
  status      JobStatus @default(PENDING)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3) @map("max_attempts")
  lockedAt    DateTime? @map("locked_at")
  lockedBy    String?   @map("locked_by")
  failedReason String?  @map("failed_reason")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([status, lockedAt])
  @@map("job_queues")
}

model MediaAsset {
  id                  String   @id @default(uuid())
  tenantId            String   @map("tenant_id")
  personId            String?  @map("person_id")
  storageKeyMaster    String   @map("storage_key_master")
  storageKeyCardReady String?  @map("storage_key_card_ready")
  storageKeyThumbnail String?  @map("storage_key_thumbnail")
  mimeType            String   @map("mime_type")
  fileSizeBytes       Int      @map("file_size_bytes")
  width               Int
  height              Int
  checksumSha256      String   @map("checksum_sha256")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  tenant              Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person              Person?  @relation("PersonMediaAssets", fields: [personId], references: [id], onDelete: SetNull)
  personPhotos        Person[] @relation("PersonPhoto")

  @@index([tenantId])
  @@index([tenantId, personId])
  @@map("media_assets")
}

model PhoneHandoffToken {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  tokenHash    String    @unique @map("token_hash")
  slotId       String    @map("slot_id")
  expiresAt    DateTime  @map("expires_at")
  isConsumed   Boolean   @default(false) @map("is_consumed")
  consumedAt   DateTime? @map("consumed_at")
  mediaAssetId String?   @map("media_asset_id")
  createdAt    DateTime  @default(now()) @map("created_at")

  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("phone_handoff_tokens")
}

// ==============================================================================
// Phase 6: Card Formats & Constrained Template Engine Models
// ==============================================================================

enum CardOrientation {
  VERTICAL
  HORIZONTAL
}

enum CardFormatPreset {
  COMPANY_VERTICAL_60X90
  ISO_ID1_HORIZONTAL
  ISO_ID1_VERTICAL
  CUSTOM
}

enum TemplatePresetId {
  CLASSIC_VERTICAL
  MODERN_STRIPE
  PHOTO_FOCUS
  FACTORY_INDUSTRIAL
  CONTRACTOR
  VISITOR
}

enum TemplateVersionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum TemplateAssignmentTarget {
  WORKER_OVERRIDE
  JOB_CATEGORY
  ORG_UNIT
  LOCATION
  ORGANIZATION
  SYSTEM
}

model CardFormat {
  id          String           @id @default(uuid())
  tenantId    String           @map("tenant_id")
  name        String
  preset      CardFormatPreset @default(COMPANY_VERTICAL_60X90)
  widthMm     Decimal          @map("width_mm") @db.Decimal(6, 2)
  heightMm    Decimal          @map("height_mm") @db.Decimal(6, 2)
  bleedMm     Decimal          @default(3.00) @map("bleed_mm") @db.Decimal(4, 2)
  safeAreaMm  Decimal          @default(3.00) @map("safe_area_mm") @db.Decimal(4, 2)
  orientation CardOrientation  @default(VERTICAL)
  isCustom    Boolean          @default(false) @map("is_custom")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  templates   CardTemplate[]

  @@index([tenantId])
  @@map("card_formats")
}

model CardTemplate {
  id              String               @id @default(uuid())
  tenantId        String               @map("tenant_id")
  organizationId  String?              @map("organization_id")
  formatId        String?              @map("format_id")
  name            String
  description     String?
  presetId        TemplatePresetId     @default(CLASSIC_VERTICAL) @map("preset_id")
  activeVersionId String?              @map("active_version_id")
  isArchived      Boolean              @default(false) @map("is_archived")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization    Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  format          CardFormat?          @relation(fields: [formatId], references: [id], onDelete: SetNull)
  versions        TemplateVersion[]
  assignments     TemplateAssignment[]

  @@index([tenantId])
  @@index([tenantId, organizationId])
  @@map("card_templates")
}

model TemplateVersion {
  id                  String                @id @default(uuid())
  templateId          String                @map("template_id")
  tenantId            String                @map("tenant_id")
  versionNumber       Int                   @map("version_number")
  status              TemplateVersionStatus @default(DRAFT)
  layoutSchemaVersion String                @default("1.0.0") @map("layout_schema_version")
  layout              Json
  checksumSha256      String?               @map("checksum_sha256")
  publishedAt         DateTime?             @map("published_at")
  publishedByUserId   String?               @map("published_by_user_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")

  template            CardTemplate          @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant              Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cardIssues          CardIssue[]

  @@unique([templateId, versionNumber])
  @@index([tenantId])
  @@index([templateId, status])
  @@map("template_versions")
}

model TemplateAssignment {
  id         String                   @id @default(uuid())
  tenantId   String                   @map("tenant_id")
  templateId String                   @map("template_id")
  targetType TemplateAssignmentTarget @map("target_type")
  targetId   String?                  @map("target_id")
  priority   Int                      @default(50)
  createdAt  DateTime                 @default(now()) @map("created_at")
  updatedAt  DateTime                 @updatedAt @map("updated_at")

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  template   CardTemplate             @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tenantId, targetType, targetId])
  @@map("template_assignments")
}

// ==============================================================================
// Phase 9: Data Portability, Safe Import & Export Engine Models
// ==============================================================================

enum ImportDuplicateStrategy {
  REJECT_DUPLICATES
  SKIP_EXISTING
  UPDATE_EXISTING
}

enum ImportCommitPolicy {
  ALL_OR_NOTHING
  PARTIAL_SUCCESS
}

enum ImportJobStatus {
  PENDING
  PARSING
  PREVIEW_READY
  DRY_RUN_COMPLETED
  COMMITTING
  COMPLETED
  FAILED
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
}

model ImportJob {
  id                String                  @id @default(uuid())
  tenantId          String                  @map("tenant_id")
  organizationId    String                  @map("organization_id")
  status            ImportJobStatus         @default(PENDING)
  fileName          String                  @map("file_name")
  fileSizeBytes     Int                     @map("file_size_bytes")
  storageKeyArchive String?                 @map("storage_key_archive")
  storageKeyCsv     String?                 @map("storage_key_csv")
  totalRows         Int                     @default(0) @map("total_rows")
  processedRows     Int                     @default(0) @map("processed_rows")
  validRows         Int                     @default(0) @map("valid_rows")
  invalidRows       Int                     @default(0) @map("invalid_rows")
  duplicateRows     Int                     @default(0) @map("duplicate_rows")
  duplicateStrategy ImportDuplicateStrategy @default(REJECT_DUPLICATES) @map("duplicate_strategy")
  commitPolicy      ImportCommitPolicy      @default(ALL_OR_NOTHING) @map("commit_policy")
  columnMapping     Json?                   @map("column_mapping")
  detectedDelimiter String?                 @default(",") @map("detected_delimiter")
  detectedEncoding  String?                 @default("UTF-8") @map("detected_encoding")
  previewRows       Json?                   @map("preview_rows")
  validationReport  Json?                   @map("validation_report")
  errorReportCsvKey String?                 @map("error_report_csv_key")
  errorMessage      String?                 @map("error_message")
  dryRunPassed      Boolean                 @default(false) @map("dry_run_passed")
  isCommitted       Boolean                 @default(false) @map("is_committed")
  createdByUserId   String                  @map("created_by_user_id")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  tenant            Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdByUser     User                    @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, organizationId])
  @@index([tenantId, status])
  @@map("import_jobs")
}

model ExportJob {
  id                   String          @id @default(uuid())
  tenantId             String          @map("tenant_id")
  organizationId       String?         @map("organization_id")
  status               ExportJobStatus @default(PENDING)
  totalWorkers         Int             @default(0) @map("total_workers")
  totalImages          Int             @default(0) @map("total_images")
  fileSizeBytes        Int?            @map("file_size_bytes")
  storageKeyZip        String?         @map("storage_key_zip")
  checksumSha256       String?         @map("checksum_sha256")
  downloadToken        String?         @unique @map("download_token")
  downloadTokenExpires DateTime?       @map("download_token_expires")
  downloadCount        Int             @default(0) @map("download_count")
  filterCriteria       Json?           @map("filter_criteria")
  includedFields       Json            @map("included_fields")
  includeSensitive     Boolean         @default(false) @map("include_sensitive")
  manifestSnapshot     Json?           @map("manifest_snapshot")
  errorMessage         String?         @map("error_message")
  expiresAt            DateTime        @map("expires_at")
  createdByUserId      String          @map("created_by_user_id")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")

  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser        User            @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([downloadToken])
  @@index([expiresAt])
  @@map("export_jobs")
}

enum BackupStatus {
  PENDING
  RUNNING
  VERIFYING
  COMPLETED
  FAILED
}

enum BackupTrigger {
  MANUAL
  SCHEDULED
  PRE_RESTORE_SAFETY
}

model BackupJob {
  id              String        @id @default(uuid())
  tenantId        String        @map("tenant_id")
  status          BackupStatus  @default(PENDING)
  trigger         BackupTrigger @default(MANUAL)
  fileName        String        @map("file_name")
  filePath        String        @map("file_path")
  fileSizeBytes   Int?          @map("file_size_bytes")
  checksumSha256  String?       @map("checksum_sha256")
  appVersion      String        @map("app_version")
  schemaVersion   String        @map("schema_version")
  totalRecords    Int           @default(0) @map("total_records")
  totalMediaFiles Int           @default(0) @map("total_media_files")
  isVerified      Boolean       @default(false) @map("is_verified")
  verifiedAt      DateTime?     @map("verified_at")
  errorMessage    String?       @map("error_message")
  durationMs      Int?          @map("duration_ms")
  createdByUserId String?       @map("created_by_user_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser   User?         @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([createdAt])
  @@map("backup_jobs")
}

model BackupSchedule {
  id              String    @id @default(uuid())
  tenantId        String    @unique @map("tenant_id")
  isEnabled       Boolean   @default(false) @map("is_enabled")
  cronExpression  String    @default("0 2 * * *") @map("cron_expression")
  retentionCount  Int       @default(7) @map("retention_count")
  targetDirectory String    @default("./backups") @map("target_directory")
  lastRunAt       DateTime? @map("last_run_at")
  nextRunAt       DateTime? @map("next_run_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("backup_schedules")
}

// ==============================================================================
// Phase 2 (Remediation): Card Issuance & Print Job Models
// ==============================================================================

enum CardIssueStatus {
  DRAFT
  RENDER_READY
  PRINTED
  ISSUED
  REPLACED
  REVOKED
  EXPIRED
  CANCELLED
}

enum CardIssueReason {
  INITIAL
  DAMAGED
  LOST
  STOLEN
  NAME_CHANGE
  TITLE_CHANGE
  PROMOTION
  TRANSFER
  EXPIRED
  OTHER
}

enum CardRevocationReason {
  SEPARATION
  SUSPENSION
  LOST_STOLEN
  SECURITY_REVOCATION
  ADMINISTRATIVE_CORRECTION
  OTHER
}

enum PrintJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum PrintJobItemStatus {
  PENDING
  RENDERING
  RENDERED
  FAILED
  SKIPPED
}

enum PrintOutputFormat {
  A4_SHEET
  LETTER_SHEET
  INDIVIDUAL_PDF
  HIGH_RES_PNG
}

enum PrintJobSide {
  FRONT
  BACK
  DUPLEX
}

enum OperatorPrintStatus {
  UNCONFIRMED
  CONFIRMED_PRINTED
  REJECTED_DEFECT
}

model CardIssue {
  id                String                @id @default(uuid())
  tenantId          String                @map("tenant_id")
  personId          String                @map("person_id")
  employmentId      String                @map("employment_id")
  templateVersionId String                @map("template_version_id")
  cardSerial        String                @map("card_serial")
  issueNumber       Int                   @default(1) @map("issue_number")
  issueReason       CardIssueReason       @default(INITIAL) @map("issue_reason")
  reasonNotes       String?               @map("reason_notes")
  status            CardIssueStatus       @default(DRAFT)
  isCurrent         Boolean               @default(false) @map("is_current")
  printedSnapshot   Json                  @map("printed_snapshot")
  layoutSnapshot    Json                  @map("layout_snapshot")
  templateChecksum  String                @map("template_checksum")
  renderManifest    Json?                 @map("render_manifest")
  pdfStorageKey     String?               @map("pdf_storage_key")
  pdfChecksumSha256 String?               @map("pdf_checksum_sha256")
  previousIssueId   String?               @map("previous_issue_id")
  issuedByUserId    String?               @map("issued_by_user_id")
  issuedAt          DateTime?             @map("issued_at")
  validUntil        DateTime?             @map("valid_until") @db.Date
  revokedByUserId   String?               @map("revoked_by_user_id")
  revokedAt         DateTime?             @map("revoked_at")
  revocationReason  CardRevocationReason? @map("revocation_reason")
  revocationNotes   String?               @map("revocation_notes")
  idempotencyKey    String?               @map("idempotency_key")
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  tenant            Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  person            Person                @relation(fields: [personId], references: [id], onDelete: Cascade)
  employment        Employment            @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  templateVersion   TemplateVersion       @relation(fields: [templateVersionId], references: [id], onDelete: Cascade)
  issuedByUser      User?                 @relation("CardIssuedByUser", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  revokedByUser     User?                 @relation("CardRevokedByUser", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  previousIssue     CardIssue?            @relation("CardIssueLineage", fields: [previousIssueId], references: [id], onDelete: SetNull)
  nextIssues        CardIssue[]           @relation("CardIssueLineage")
  printJobItems     PrintJobItem[]

  @@unique([tenantId, cardSerial])
  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, personId])
  @@index([tenantId, employmentId])
  @@index([tenantId, isCurrent])
  @@index([tenantId, cardSerial])
  @@map("card_issues")
}

model PrintJob {
  id                   String              @id @default(uuid())
  tenantId             String              @map("tenant_id")
  status               PrintJobStatus      @default(QUEUED)
  outputFormat         PrintOutputFormat   @default(A4_SHEET) @map("output_format")
  side                 PrintJobSide        @default(DUPLEX)
  totalItems           Int                 @default(0) @map("total_items")
  processedItems       Int                 @default(0) @map("processed_items")
  failedItems          Int                 @default(0) @map("failed_items")
  outputStorageKey     String?             @map("output_storage_key")
  outputFileSizeBytes  Int?                @map("output_file_size_bytes")
  outputChecksumSha256 String?             @map("output_checksum_sha256")
  mimeType             String?             @map("mime_type")
  attempts             Int                 @default(0)
  maxAttempts          Int                 @default(3) @map("max_attempts")
  lockedAt             DateTime?           @map("locked_at")
  lockedBy             String?             @map("locked_by")
  failedReason         String?             @map("failed_reason")
  operatorStatus       OperatorPrintStatus @default(UNCONFIRMED) @map("operator_status")
  confirmedByUserId    String?             @map("confirmed_by_user_id")
  confirmedAt          DateTime?           @map("confirmed_at")
  confirmationNotes    String?             @map("confirmation_notes")
  idempotencyKey       String?             @map("idempotency_key")
  createdByUserId      String?             @map("created_by_user_id")
  startedAt            DateTime?           @map("started_at")
  completedAt          DateTime?           @map("completed_at")
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdByUser        User?               @relation("PrintJobCreatedByUser", fields: [createdByUserId], references: [id], onDelete: SetNull)
  confirmedByUser      User?               @relation("PrintJobConfirmedByUser", fields: [confirmedByUserId], references: [id], onDelete: SetNull)
  items                PrintJobItem[]

  @@unique([tenantId, idempotencyKey])
  @@index([tenantId, status])
  @@index([tenantId, operatorStatus])
  @@index([tenantId, createdAt])
  @@map("print_jobs")
}

model PrintJobItem {
  id           String             @id @default(uuid())
  tenantId     String             @map("tenant_id")
  printJobId   String             @map("print_job_id")
  cardIssueId  String             @map("card_issue_id")
  itemIndex    Int                @default(0) @map("item_index")
  status       PrintJobItemStatus @default(PENDING)
  sheetNumber  Int?               @map("sheet_number")
  gridRow      Int?               @map("grid_row")
  gridColumn   Int?               @map("grid_column")
  copies       Int                @default(1)
  errorMessage String?            @map("error_message")
  renderedAt   DateTime?          @map("rendered_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  tenant       Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  printJob     PrintJob           @relation(fields: [printJobId], references: [id], onDelete: Cascade)
  cardIssue    CardIssue          @relation(fields: [cardIssueId], references: [id], onDelete: Cascade)

  @@index([tenantId, printJobId])
  @@index([tenantId, cardIssueId])
  @@index([printJobId, itemIndex])
  @@map("print_job_items")
}





