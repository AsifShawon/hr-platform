{
  "name": "hr-platform",
  "private": true,
  "packageManager": "pnpm@10.5.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @hr/web test:e2e",
    "db:migrate": "pnpm --filter @hr/db db:migrate",
    "db:seed": "pnpm --filter @hr/db db:seed",
    "db:generate": "pnpm --filter @hr/db db:generate",
    "release:manifest": "tsx scripts/build-release-package.ts",
    "test:compose": "vitest run tests/compose-smoke.test.ts",
    "test:e2e:live": "vitest run tests/e2e-live"
  },
  "devDependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^10.1.1",
    "@fastify/sensible": "^6.0.3",
    "@node-rs/argon2": "^2.1.0",
    "adm-zip": "^0.6.0",
    "fastify": "^5.2.1",
    "pino": "^9.6.0",
    "prettier": "^3.5.2",
    "sharp": "^0.35.3",
    "tsx": "^4.19.3",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
